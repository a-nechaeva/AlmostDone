# Скопируйте в backend/.env и заполните. backend/.env в git не попадает.
GIGACHAT_CREDENTIALS=<ключ авторизации из личного кабинета Сбера>
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra

# Только для запуска без Docker, из папки backend (в Docker путь задан в образе):
GIGACHAT_CA_BUNDLE_FILE=../engine/certs/russian_trusted_root_ca.pem

# Положить в кладовку демо-набор продуктов при старте (true/false)
DEMO_PANTRY=true

# PostgreSQL. Не задан — каталог читается прямо из db/seed.sql (без базы и Docker)
# DATABASE_URL=postgresql://koma:almostdone@localhost:5432/almostdone
