# Use the existing database from db/schema.sql or db/seed.sql; no API migration.
ALMOSTDONE_DATABASE_URL=postgresql://localhost/almostdone
ALMOSTDONE_YANDEX_CLIENT_ID=
ALMOSTDONE_VK_CLIENT_ID=
ALMOSTDONE_VK_REDIRECT_URI=
# The built-in dishgraph recognizer uses GigaChat when these are configured.
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_BUNDLE_FILE=engine/certs/russian_trusted_root_ca.pem
